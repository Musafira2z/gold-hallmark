# Copy this file to .env (next to docker-compose.yml) and fill in what you need.

# App version to run: the 7-character tag from GitHub Actions / Docker Hub, e.g. 679cf84.
# With a fixed version, "docker compose pull" never updates the app by surprise.
# Leave empty to use :latest.
APP_VERSION=

# Where backups are written (default ./backups). Example for Google Drive on Windows:
# BACKUP_HOST_DIR=G:/My Drive/gold-backups

# Where photos are kept (default ./uploads, next to this file). Backups copy them to backups/photos.
# UPLOADS_HOST_DIR=./uploads

# Who can open the app: 127.0.0.1 = only this PC. Leave empty = any device on the shop network.
# Everyone must log in either way.
BIND_ADDRESS=

# Online website (mirror). Leave empty until the website is live.
# REPORT_BASE_URL = address printed in the memo QR, e.g. https://sylhethallmark.com
# SYNC_URL = where orders are sent (usually the same address); SYNC_KEY = same secret as on the website.
REPORT_BASE_URL=
SYNC_URL=
SYNC_KEY=
